---
layout: default
---
<div class="post academic-home">
  <header class="home-hero">
    <div class="hero-copy">
      <p class="home-eyebrow"><span aria-hidden="true"></span> ROBOTICS · VISION · EMBODIED AI</p>
      <h1>
        {% if site.title == 'blank' -%}
          {{- site.first_name }}
          {{ site.middle_name }}
          {{ site.last_name -}}
        {%- else -%}
          {{- site.title -}}
        {%- endif %}
      </h1>
      <p class="hero-subtitle">{{ page.subtitle }}</p>
      <div class="hero-bio">{{ content }}</div>
      <div class="hero-actions">
        <a class="home-button primary" href="#demos">Watch robot demos <span aria-hidden="true">↗</span></a>
        {% if site.email -%}
          <a class="home-button" href="mailto:{{ site.email }}">Get in touch <span aria-hidden="true">↗</span></a>
        {%- endif %}
      </div>
    </div>
    {% if page.profile %}
      <aside class="hero-profile" aria-label="Profile">
        {% if page.profile.image %}
          {% assign profile_image_path = page.profile.image | prepend: 'assets/img/' %}
          {% capture profile_alt %}{{ site.first_name }} {{ site.last_name }}{% endcapture %}
          {% include figure.liquid loading="eager" path=profile_image_path class="hero-portrait" sizes="(min-width: 768px) 280px, 70vw" alt=profile_alt cache_bust=true %}
        {% endif %}
        <div class="profile-caption"><span class="profile-label">BASED IN</span><span>Shanghai, China</span></div>
        {% if page.profile.more_info %}
          <div class="profile-details">{{ page.profile.more_info }}</div>
        {% endif %}
      </aside>
    {% endif %}
  </header>

  <section id="demos" class="demo-section" aria-labelledby="demo-title">
    <div class="demo-heading">
      <div>
        <p class="home-eyebrow">EMBODIED INTELLIGENCE / IN ACTION</p>
        <h2 id="demo-title">Robots learning to act.</h2>
      </div>
      <a href="#research">All publications ↓</a>
    </div>
    <p class="demo-intro">From affordance-aware manipulation to humanoid whole-body control. Watch the robots in action.</p>
    <div class="featured-demos">
      {% for item in site.data.featured_demos %}
        <article class="featured-demo">
          {% include demo_video.liquid src=item.src title=item.title caption=item.caption poster=item.poster featured=true %}
          <div class="demo-card-copy">
            <span class="home-paper-meta">{{ item.venue }}</span>
            <h3>{{ item.title }}</h3>
            <p>{{ item.description }}</p>
            <a href="{{ item.project }}">Explore project ↗</a>
          </div>
        </article>
      {% endfor %}
    </div>
  </section>
  <article id="research">
    <div class="research-heading">
      <p class="home-eyebrow">RESEARCH & PUBLICATIONS</p>
      <h2>From perception to action.</h2>
      <p>Vision-language-action models, diffusion policies, and robotic manipulation.</p>
      <a href="https://scholar.google.com/citations?user=kzgMk0gAAAAJ&amp;hl=en">Google Scholar ↗</a>
    </div>
    {% include embodied_ai_papers.liquid %}

    {% if page.news and site.announcements.enabled %}
      <section class="home-updates">
        <h2><a href="{{ '/news/' | relative_url }}">News</a></h2>
        {% include news.liquid limit=true %}
      </section>
    {% endif %}
    {% if site.latest_posts.enabled %}
      <section class="home-updates">
        <h2><a href="{{ '/blog/' | relative_url }}">Latest posts</a></h2>
        {% include latest_posts.liquid %}
      </section>
    {% endif %}

    {% if page.social %}
      <div class="social home-social">
        <div class="contact-icons">{% include social.liquid %}</div>
        <div class="contact-note">{{ site.contact_note }}</div>
      </div>
    {% endif %}
    {% if site.newsletter.enabled and site.footer_fixed %}{% include scripts/newsletter.liquid center=true %}{% endif %}
  </article>
</div>

<script src="{{ "/assets/js/robot-demos.js" | relative_url }}" defer></script>
