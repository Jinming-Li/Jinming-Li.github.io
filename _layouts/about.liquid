---
layout: default
---
<div class="post academic-home">
  <header class="home-hero">
    <div class="hero-copy">
      <p class="home-eyebrow"><span aria-hidden="true"></span> ROBOTICS · VISION · EMBODIED AI</p>
      <h1>
        {% if site.title == 'blank' -%}
          {{- site.first_name }}
          {{ site.middle_name }}
          {{ site.last_name -}}
        {%- else -%}
          {{- site.title -}}
        {%- endif %}
      </h1>
      <p class="hero-subtitle">{{ page.subtitle }}</p>
      <div class="hero-bio">{{ content }}</div>
      <div class="hero-actions">
        <a class="home-button primary" href="#research">Explore research <span aria-hidden="true">↗</span></a>
        {% if site.email -%}
          <a class="home-button" href="mailto:{{ site.email }}">Get in touch <span aria-hidden="true">↗</span></a>
        {%- endif %}
      </div>
    </div>
    {% if page.profile %}
      <aside class="hero-profile" aria-label="Profile">
        {% if page.profile.image %}
          {% assign profile_image_path = page.profile.image | prepend: 'assets/img/' %}
          {% capture profile_alt %}{{ site.first_name }} {{ site.last_name }}{% endcapture %}
          {% include figure.liquid loading="eager" path=profile_image_path class="hero-portrait" sizes="(min-width: 768px) 280px, 70vw" alt=profile_alt cache_bust=true %}
        {% endif %}
        <div class="profile-caption"><span class="profile-label">BASED IN</span><span>Shanghai, China</span></div>
        {% if page.profile.more_info %}
          <div class="profile-details">{{ page.profile.more_info }}</div>
        {% endif %}
      </aside>
    {% endif %}
  </header>

  <nav class="research-nav" aria-label="Research topics">
    <span class="nav-label">RESEARCH AREAS</span>
    {% if page.embodied_ai -%}
      <a href="#embodied-ai">Embodied intelligence <span aria-hidden="true">↗</span></a>
    {%- endif %}
    {% if page.vision_research -%}
      <a href="#computer-vision">Computer vision <span aria-hidden="true">↗</span></a>
    {%- endif %}
    {% if page.pointcloud_research -%}
      <a href="#point-cloud">3D perception <span aria-hidden="true">↗</span></a>
    {%- endif %}
  </nav>

  <article id="research">
    <div class="research-heading">
      <p class="home-eyebrow">RESEARCH & PUBLICATIONS</p>
      <h2>From perception to action.</h2>
      <p>Exploring how intelligent systems see, understand, and interact with the world.</p>
    </div>
    {% if page.embodied_ai %}
      <section class="research-section" id="embodied-ai" aria-labelledby="embodied-title">
        <div class="research-intro">
          <span class="research-number">01 /</span>
          <h3 id="embodied-title">
            Embodied <br>
            intelligence
          </h3>
          <p>{{ page.embodied_ai_content }}</p>
          <span class="research-tag">Robotic manipulation</span><span class="research-tag">Foundation models</span>
        </div>
        <div class="research-papers">
          {% if page.embodied_ai_papers %}
            <h4>Related publications</h4>
            {% include embodied_ai_papers.liquid -%}
          {%- endif %}
        </div>
      </section>
    {% endif %}
    {% if page.vision_research %}
      <section class="research-section" id="computer-vision" aria-labelledby="vision-title">
        <div class="research-intro">
          <span class="research-number">02 /</span>
          <h3 id="vision-title">
            Computer <br>
            vision
          </h3>
          <p>{{ page.vision_content }}</p>
          <span class="research-tag">Scene understanding</span><span class="research-tag">Visual reasoning</span>
        </div>
        <div class="research-papers">
          {% if page.vision_papers %}
            <h4>Related publications</h4>
            {% include vision_papers.liquid -%}
          {%- endif %}
        </div>
      </section>
    {% endif %}
    {% if page.pointcloud_research %}
      <section class="research-section" id="point-cloud" aria-labelledby="pointcloud-title">
        <div class="research-intro">
          <span class="research-number">03 /</span>
          <h3 id="pointcloud-title">3D perception</h3>
          <p>{{ page.pointcloud_content }}</p>
          <span class="research-tag">Point clouds</span><span class="research-tag">Segmentation</span>
        </div>
        <div class="research-papers">
          {% if page.pointcloud_papers %}
            <h4>Related publications</h4>
            {% include pointcloud_papers.liquid -%}
          {%- endif %}
        </div>
      </section>
    {% endif %}

    {% if page.news and site.announcements.enabled %}
      <section class="home-updates">
        <h2><a href="{{ '/news/' | relative_url }}">News</a></h2>
        {% include news.liquid limit=true %}
      </section>
    {% endif %}
    {% if site.latest_posts.enabled %}
      <section class="home-updates">
        <h2><a href="{{ '/blog/' | relative_url }}">Latest posts</a></h2>
        {% include latest_posts.liquid %}
      </section>
    {% endif %}

    {% if page.wechat %}
      <section class="home-connect" aria-labelledby="connect-title">
        <div>
          <p class="home-eyebrow">LET’S CONNECT</p>
          <h2 id="connect-title">Ideas worth sharing.</h2>
          <div class="connect-copy">{{ page.wechat_content | markdownify }}</div>
        </div>
        {% if page.wechat_qr %}
          <figure class="connect-qr">
            {% assign wechat_qr_path = page.wechat_qr | prepend: 'assets/img/' %}
            {% if page.wechat_url and page.wechat_url != '' %}<a href="{{ page.wechat_url }}" target="_blank" rel="noopener noreferrer">{% endif %}
            <img src="{{ wechat_qr_path | relative_url }}" alt="微信公众号二维码" width="144" height="144" loading="lazy">
            {% if page.wechat_url and page.wechat_url != '' %}</a>{% endif %}
            <figcaption>WeChat · 扫码交流</figcaption>
          </figure>
        {% endif %}
      </section>
    {% endif %}
    {% unless page.wechat %}
      <section class="home-connect email-connect" aria-labelledby="email-connect-title">
        <div>
          <p class="home-eyebrow">LET’S CONNECT</p>
          <h2 id="email-connect-title">Ideas worth sharing.</h2>
          <p class="connect-copy">Interested in embodied intelligence, robotics, or computer vision? Let’s start a conversation.</p>
        </div>
        {% if site.email -%}
          <a class="home-button primary" href="mailto:{{ site.email }}">Say hello <span aria-hidden="true">↗</span></a>
        {%- endif %}
      </section>
    {% endunless %}
    {% if page.social %}
      <div class="social home-social">
        <div class="contact-icons">{% include social.liquid %}</div>
        <div class="contact-note">{{ site.contact_note }}</div>
      </div>
    {% endif %}
    {% if site.newsletter.enabled and site.footer_fixed %}{% include scripts/newsletter.liquid center=true %}{% endif %}
  </article>
</div>
