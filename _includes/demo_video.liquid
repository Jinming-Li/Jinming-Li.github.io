<figure class="robot-demo">
  <video
    {% if include.featured %}
      data-preview="true"
    {% endif %}
    controls
    muted
    playsinline
    loop
    preload="none"
    aria-label="{{ include.title | escape }} demonstration"
    {% if include.poster %}
      poster="{{ include.poster | prepend: '/assets/img/publication_preview/' | relative_url }}"
    {% endif %}
    style="display:block;width:100%;aspect-ratio:16/9;object-fit:contain;background:#101815;border-radius:6px"
  >
    <source src="{{ include.src | relative_url }}" type="video/mp4">
    Your browser does not support embedded video. <a href="{{ include.src }}">Open the demo</a>.
  </video>
  <p class="demo-error" hidden>Video could not load. Please try again or open the project demo below.</p>
  {% if include.caption %}
    <figcaption>{{ include.caption }}</figcaption>
  {% endif %}
</figure>
